# =================================================================
# .gitignore for ~/.claude/.claude/ (PAI Directory)
# =================================================================
#
# CRITICAL SECURITY WARNING:
# This PAI directory contains personal information, preferences,
# and potentially sensitive data. DO NOT commit this to public repos!
#
# Only use git for PAI if:
# 1. Repository is PRIVATE
# 2. You've reviewed ALL files for sensitive data
# 3. You've triple-checked git remote -v
# 4. You understand the risks
# =================================================================

# =================================================================
# SENSITIVE FILES - NEVER COMMIT THESE
# =================================================================

# Environment variables and secrets
.env
.env.*
*.env
secrets.json
credentials.json
api-keys.json

# MCP configuration (may contain API keys)
.mcp.json
mcp.json

# Voice system API keys
voice-config.json

# Personal data
contacts/
personal/
private/

# Session logs (may contain sensitive info)
logs/
*.log
session-*.json

# =================================================================
# NODE.JS / BUN
# =================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# Bun
.bun/
bun.lockb

# Build outputs
dist/
build/
*.tsbuildinfo

# Cache
.cache/
.parcel-cache/
.turbo/

# =================================================================
# TYPESCRIPT
# =================================================================

# Compiled JavaScript from TypeScript
hooks/*.js
hooks/**/*.js
!hooks/**/*.config.js

# TypeScript cache
*.tsbuildinfo
.tsbuildinfo/

# =================================================================
# MACOS
# =================================================================

.DS_Store
.AppleDouble
.LSOverride

# Icon files
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# =================================================================
# LINUX
# =================================================================

*~

# temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*


# Ogmios Voice Server Configuration
# ==================================
#
# Copy this file to .env and fill in your actual values:
# cp .env.example .env

# ============================================================================
# REQUIRED: ElevenLabs API Configuration
# ============================================================================

# Your ElevenLabs API key (REQUIRED)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_api_key_here

# ============================================================================
# Server Configuration
# ============================================================================

# Port for voice server (default: 8888)
PORT=8888

# Host to bind to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 for localhost only
HOST=0.0.0.0

# Debug mode (default: false)
# Set to true for development, false for production
DEBUG=false

# ============================================================================
# Voice Settings (Optional - Fine-tuning)
# ============================================================================

# Default voice ID to use if not specified in request
# Get voice IDs from: https://elevenlabs.io/app/voice-library
# Or use /voices endpoint to list available voices
DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Voice stability (0.0-1.0, default: 0.5)
# Lower = more expressive, Higher = more stable
DEFAULT_STABILITY=0.5

# Similarity boost (0.0-1.0, default: 0.75)
# Higher = closer to original voice, Lower = more creative
DEFAULT_SIMILARITY_BOOST=0.75

# Style intensity (0.0-1.0, default: 0.0)
# Only works with certain voices
# Higher = more exaggerated style
DEFAULT_STYLE=0.0

# Speaker boost (true/false, default: true)
# Enhances voice clarity
DEFAULT_USE_SPEAKER_BOOST=true

# ============================================================================
# Audio Configuration
# ============================================================================

# Audio output format
# Options: mp3_44100_128, mp3_44100_64, pcm_16000, pcm_22050, pcm_24000
# Default: mp3_44100_128 (high quality)
AUDIO_FORMAT=mp3_44100_128

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (relative or absolute)
LOG_FILE=voice-server.log

# ============================================================================
# Example Voice IDs (from ElevenLabs)
# ============================================================================
#
# These are example voice IDs - replace with your preferred voices:
#
# VOICE_ENGINEERING=21m00Tcm4TlvDq8ikWAM      # Rachel (US Female)
# VOICE_RESEARCH=AZnzlk1XvdvUeBnXmlld          # Domi (US Female)
# VOICE_ARCHITECTURE=EXAVITQu4vr4xnSDxMaL      # Bella (US Female)
# VOICE_TECHNICAL_WRITING=ErXwobaYiN019PkySvjV # Antoni (US Male)
# VOICE_DATA_ANALYSIS=MF3mGyEYCl7XYWbV9V6O     # Elli (US Female)
# VOICE_DEVOPS=TxGEqnHWrfWFTfGW9XjX            # Josh (US Male)
# VOICE_SECURITY=VR6AewLTigWG4xSOukaG          # Arnold (US Male)
# VOICE_DEFAULT=21m00Tcm4TlvDq8ikWAM          # Rachel (fallback)

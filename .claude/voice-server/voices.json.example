{
  "description": "Ogmios Voice Configuration - Maps skills and agents to ElevenLabs voice IDs",
  "instructions": [
    "1. Copy this file to voices.json: cp voices.json.example voices.json",
    "2. Get your voice IDs from https://elevenlabs.io/app/voice-library",
    "3. Replace <VOICE_ID_*> placeholders with actual ElevenLabs voice IDs",
    "4. Customize voice names and accents as needed",
    "5. Add new skills/agents as your system grows"
  ],
  "default_settings": {
    "stability": 0.5,
    "similarity_boost": 0.75,
    "style": 0.0,
    "use_speaker_boost": true
  },
